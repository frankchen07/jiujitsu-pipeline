# pipeline.config — pipeline stage definitions and phase commands
# Sourced by .claude/skills/run.md so Claude knows how to operate this pipeline.
# Shell-sourceable: bash scripts can also source this file.

# Stage folders (relative to project root)
STAGE_SOURCE="rolling"       # raw input files land here
STAGE_ARCHIVE="sstready"    # encoded archive copies (with audio)
STAGE_DELIVER="ytready"     # delivery-ready copies (audio stripped for YT)
STAGE_TRASH=".trash"        # files pending deletion

# Logging
LOG_DIR="logs"
LOG_DATE_FORMAT="%Y-%m-%d"  # used in log filenames

# Publish quota (max per day, enforced by CMD_PUBLISH)
PUBLISH_QUOTA=30

# Phase commands
CMD_INGEST="bash ingest.sh"
CMD_TRANSFORM="bash process.sh --convert-only"
CMD_PUBLISH="bash process.sh --upload-only"
CMD_FULL="bash process.sh"

# Log file patterns (relative to LOG_DIR, % replaced with today's date)
LOG_PROCESS="%-process.md"
LOG_STATUS="%-process.status"
LOG_PROGRESS="%-process.progress"
LOG_UPLOAD_STATE="%-upload-state.tsv"
LOG_RENAMES="%-renames.tsv"
LOG_INGEST="%-ingest.log"
